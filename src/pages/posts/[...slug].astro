---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: index < sorted.length - 1 ? { slug: sorted[index + 1].id, title: sorted[index + 1].data.title } : null,
      next: index > 0 ? { slug: sorted[index - 1].id, title: sorted[index - 1].data.title } : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  date={post.data.date}
  prev={prev}
  next={next}
>
  {post.data.thumbnail && (
    <figure class="article-thumbnail">
      <Image src={post.data.thumbnail} alt={post.data.title} width={800} />
    </figure>
  )}
  <Content />
</ArticleLayout>
