---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryByLabel, fallbackCategory } from '../categories';
import ArticleThumb from '../components/ArticleThumb.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<BaseLayout title="一留底辺ブログ - ゲーム・ITのTips集">
  <main class="site-main" id="main-content" tabindex="-1">

    <!-- ヒーロー -->
    <section class="hero">
      <h1 class="hero-title">ゲーム・ツールのTips集</h1>
      <p class="hero-desc">小さなバグ修正、Windows互換性の問題、面倒ごとをサクッと解決する個人メモブログ。<br>※自分用の備忘録です。内容の正確性は保証しません。</p>
    </section>

    <!-- カテゴリフィルター -->
    <div class="category-filter" id="category-filter" role="group" aria-label="記事カテゴリ">
      <button class="filter-btn active" type="button" data-category="all" data-category-id="all" aria-pressed="true">すべて</button>
      {categories.map((c) => (
        <button class="filter-btn" type="button" data-category={c.label} data-category-id={c.id} aria-pressed="false">{c.label}</button>
      ))}
    </div>
    <p class="sr-only" id="filter-status" role="status"></p>

    <!-- 記事一覧 -->
    <h2 class="section-title">最新の記事</h2>

    <div class="articles-grid" id="articles-grid">
      {sortedPosts.map((post) => {
        const cat = post.data.category;
        const dateStr = post.data.date.toLocaleDateString('ja-JP');
        const thumb = post.data.thumb;
        return (
          <article class="article-card" data-category={cat}>
            {post.data.thumbnail ? (
              <div class="card-thumbnail-image">
                <Image src={post.data.thumbnail} alt={post.data.title} width={800} densities={[1]} />
                <span class="editorial-eyebrow">{(categoryByLabel[cat] ?? fallbackCategory).eyebrowLabel}</span>
              </div>
            ) : thumb ? (
              <ArticleThumb
                category={cat}
                motif={thumb.motif}
              />
            ) : (
              <div class="editorial-thumb" style="background:#1a1a1a;color:#c8c8c8">
                <span class="editorial-eyebrow" style="color:#999">ETC</span>
              </div>
            )}
            <div class="card-meta">
              <h3 class="card-title">
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="card-excerpt">{post.data.description}</p>
              <div class="card-footer">
                <span class="card-date">{dateStr}</span>
                <a href={`/posts/${post.id}`} class="read-more">続きを読む →</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 無限スクロール sentinel -->
    <div id="infinite-scroll-sentinel" style="height: 1px;"></div>

  </main>

  <script>
    // カテゴリフィルター + 無限スクロール
    (function initArticles() {
      const filterArea = document.getElementById('category-filter');
      const filterStatus = document.getElementById('filter-status');
      const grid = document.getElementById('articles-grid');
      const sentinel = document.getElementById('infinite-scroll-sentinel');
      if (!grid) return;

      const PAGE_SIZE = 9;
      const allCards = Array.from(grid.querySelectorAll('.article-card')) as HTMLElement[];
      let currentCategory = 'all';
      let loadedCount = 0;

      function getCategoryButton(categoryId: string) {
        if (!filterArea) return null;
        return Array.from(filterArea.querySelectorAll<HTMLButtonElement>('[data-category-id]'))
          .find((button) => button.dataset.categoryId === categoryId) ?? null;
      }

      function getFiltered() {
        return allCards.filter(function (card) {
          return currentCategory === 'all' || card.dataset.category === currentCategory;
        });
      }

      function loadMore() {
        const filtered = getFiltered();
        const batch = filtered.slice(loadedCount, loadedCount + PAGE_SIZE);
        batch.forEach(function (card) {
          card.style.display = '';
          card.classList.remove('card-fade-in');
          void card.offsetWidth;
          card.classList.add('card-fade-in');
        });
        loadedCount += batch.length;
      }

      function resetAndLoad(category: string, categoryId: string) {
        currentCategory = category;
        loadedCount = 0;
        allCards.forEach(function (card) {
          card.style.display = 'none';
          card.classList.remove('card-fade-in');
        });
        loadMore();

        if (filterArea) {
          filterArea.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(function (button) {
            const isActive = button.dataset.categoryId === categoryId;
            button.classList.toggle('active', isActive);
            button.setAttribute('aria-pressed', String(isActive));
          });
        }

        const navLinks = document.querySelectorAll<HTMLElement>('[data-home-link], [data-category-link]');
        navLinks.forEach(function (link) {
          const isActive = categoryId === 'all'
            ? link.hasAttribute('data-home-link')
            : link.dataset.categoryLink === categoryId;
          link.classList.toggle('nav-active', isActive);
          if (isActive) link.setAttribute('aria-current', categoryId === 'all' ? 'page' : 'location');
          else link.removeAttribute('aria-current');
        });

        if (filterStatus) {
          const label = categoryId === 'all' ? 'すべて' : category;
          filterStatus.textContent = `${label}の記事が${getFiltered().length}件あります`;
        }
      }

      function applyCategoryFromHash() {
        const categoryId = window.location.hash.slice(1).toLowerCase() || 'all';
        const button = getCategoryButton(categoryId) ?? getCategoryButton('all');
        if (!button) return;
        resetAndLoad(button.dataset.category ?? 'all', button.dataset.categoryId ?? 'all');
      }

      applyCategoryFromHash();

      if (filterArea) {
        const buttons = filterArea.querySelectorAll<HTMLButtonElement>('.filter-btn');
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            const categoryId = btn.dataset.categoryId ?? 'all';
            const url = categoryId === 'all'
              ? `${window.location.pathname}${window.location.search}`
              : `#${categoryId}`;
            window.history.pushState(null, '', url);
            resetAndLoad(btn.dataset.category ?? 'all', categoryId);
          });
        });
      }

      window.addEventListener('hashchange', applyCategoryFromHash);
      window.addEventListener('popstate', applyCategoryFromHash);

      if (!sentinel || !window.IntersectionObserver) return;

      let scrollEnabled = false;

      window.addEventListener('scroll', function onFirstScroll() {
        scrollEnabled = true;
        window.removeEventListener('scroll', onFirstScroll);
      }, { passive: true });

      const observer = new IntersectionObserver(function (entries) {
        if (!scrollEnabled) return;
        if (!entries[0].isIntersecting) return;
        const filtered = getFiltered();
        if (loadedCount < filtered.length) {
          loadMore();
        }
      }, { rootMargin: '0px' });

      observer.observe(sentinel);
    })();
  </script>
</BaseLayout>
