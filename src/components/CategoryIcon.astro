---
interface Props {
  category: string;
  size?: number;
}

const { category, size = 64 } = Astro.props;
---

{category === 'ゲーム' && (
  <svg class="card-thumb-svg" width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Game Controller -->
    <rect x="8" y="18" width="48" height="30" rx="15" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.9)" stroke-width="2"/>
    <!-- D-pad -->
    <rect x="17" y="28" width="4" height="14" rx="1.5" fill="rgba(255,255,255,0.85)"/>
    <rect x="12" y="33" width="14" height="4" rx="1.5" fill="rgba(255,255,255,0.85)"/>
    <!-- Buttons -->
    <circle cx="43" cy="29" r="3" fill="rgba(255,255,255,0.85)"/>
    <circle cx="49" cy="35" r="3" fill="rgba(255,255,255,0.85)"/>
    <circle cx="37" cy="35" r="3" fill="rgba(255,255,255,0.85)"/>
    <circle cx="43" cy="41" r="3" fill="rgba(255,255,255,0.85)"/>
    <!-- Analog sticks -->
    <circle cx="24" y="0" cy="45" r="0" fill="none"/>
    <!-- Bumpers -->
    <rect x="12" y="16" width="12" height="4" rx="2" fill="rgba(255,255,255,0.5)"/>
    <rect x="40" y="16" width="12" height="4" rx="2" fill="rgba(255,255,255,0.5)"/>
  </svg>
)}

{category === 'IT' && (
  <svg class="card-thumb-svg" width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Monitor -->
    <rect x="10" y="10" width="44" height="32" rx="3" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.9)" stroke-width="2"/>
    <!-- Screen -->
    <rect x="14" y="14" width="36" height="24" rx="1" fill="rgba(255,255,255,0.15)"/>
    <!-- Code lines -->
    <rect x="18" y="19" width="14" height="2" rx="1" fill="rgba(255,255,255,0.7)"/>
    <rect x="18" y="24" width="20" height="2" rx="1" fill="rgba(255,255,255,0.5)"/>
    <rect x="18" y="29" width="10" height="2" rx="1" fill="rgba(255,255,255,0.7)"/>
    <rect x="30" y="29" width="8" height="2" rx="1" fill="rgba(255,255,255,0.4)"/>
    <!-- Cursor -->
    <rect x="18" y="34" width="1.5" height="2" fill="rgba(255,255,255,0.9)"/>
    <!-- Stand -->
    <rect x="27" y="42" width="10" height="4" rx="1" fill="rgba(255,255,255,0.6)"/>
    <rect x="22" y="46" width="20" height="3" rx="1.5" fill="rgba(255,255,255,0.5)"/>
  </svg>
)}

{category === 'FX' && (
  <svg class="card-thumb-svg" width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Chart background -->
    <rect x="10" y="10" width="44" height="40" rx="3" fill="rgba(255,255,255,0.1)"/>
    <!-- Grid lines -->
    <line x1="10" y1="25" x2="54" y2="25" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
    <line x1="10" y1="35" x2="54" y2="35" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
    <!-- Candlesticks -->
    <line x1="18" y1="18" x2="18" y2="40" stroke="rgba(255,255,255,0.6)" stroke-width="1"/>
    <rect x="15.5" y="22" width="5" height="10" rx="0.5" fill="rgba(255,255,255,0.8)"/>
    <line x1="26" y1="20" x2="26" y2="38" stroke="rgba(255,255,255,0.6)" stroke-width="1"/>
    <rect x="23.5" y="25" width="5" height="8" rx="0.5" fill="rgba(255,255,255,0.5)"/>
    <line x1="34" y1="16" x2="34" y2="36" stroke="rgba(255,255,255,0.6)" stroke-width="1"/>
    <rect x="31.5" y="18" width="5" height="12" rx="0.5" fill="rgba(255,255,255,0.8)"/>
    <line x1="42" y1="14" x2="42" y2="32" stroke="rgba(255,255,255,0.6)" stroke-width="1"/>
    <rect x="39.5" y="16" width="5" height="10" rx="0.5" fill="rgba(255,255,255,0.5)"/>
    <line x1="50" y1="12" x2="50" y2="28" stroke="rgba(255,255,255,0.6)" stroke-width="1"/>
    <rect x="47.5" y="14" width="5" height="8" rx="0.5" fill="rgba(255,255,255,0.8)"/>
    <!-- Trend line -->
    <polyline points="18,30 26,28 34,22 42,20 50,16" stroke="rgba(255,255,255,0.9)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{category === 'その他' && (
  <svg class="card-thumb-svg" width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Paper -->
    <path d="M16 8 L42 8 L50 16 L50 56 L16 56 Z" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.9)" stroke-width="2" stroke-linejoin="round"/>
    <!-- Fold -->
    <path d="M42 8 L42 16 L50 16" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linejoin="round"/>
    <!-- Lines -->
    <rect x="22" y="24" width="22" height="2" rx="1" fill="rgba(255,255,255,0.6)"/>
    <rect x="22" y="30" width="18" height="2" rx="1" fill="rgba(255,255,255,0.5)"/>
    <rect x="22" y="36" width="22" height="2" rx="1" fill="rgba(255,255,255,0.6)"/>
    <rect x="22" y="42" width="14" height="2" rx="1" fill="rgba(255,255,255,0.4)"/>
    <!-- Pencil -->
    <line x1="40" y1="50" x2="48" y2="42" stroke="rgba(255,255,255,0.7)" stroke-width="2" stroke-linecap="round"/>
    <circle cx="40" cy="50" r="1" fill="rgba(255,255,255,0.9)"/>
  </svg>
)}
